# Backend API base URL (includes /api/v1).
# Local dev: leave as /api/v1 so Next.js proxies to BACKEND_INTERNAL_URL (default http://127.0.0.1:8000).
# Vercel:    https://<your-render-service>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# Optional: EmailJS (welcome email on sign-up; built-in defaults are used if empty)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
