# Copy to .env (project root) or backend/.env and fill in. Never commit the real .env.

# Application
APP_NAME=Smart AI Academic Assistant
ENVIRONMENT=development          # set to "production" when deployed
DEBUG=true                       # false in production
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000            # production: your Vercel URL(s), comma-separated
CORS_ORIGIN_REGEX=                            # optional, e.g. https://smart-ai-academic-assistant-.*\.vercel\.app

# Security (production refuses to start unless JWT_SECRET is >= 32 random chars)
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440        # 1 day
BCRYPT_ROUNDS=12

# MongoDB (local) or MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=smart_academic

# Vector search for uploaded documents: auto (ChromaDB if installed, else MongoDB) | mongo | chroma
VECTOR_STORE=auto
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=academic_chunks
EMBEDDING_DIMENSIONS=1536

# AI (any OpenAI-compatible API; Gemini shown). AI_API_KEYS accepts several comma-separated keys.
AI_API_KEYS=
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_CHAT_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-2

# Uploads: local (disk at UPLOAD_DIR) | gridfs (inside MongoDB; use on hosts without a persistent disk)
FILE_STORAGE=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,docx,pptx,ppt,txt,png,jpg,jpeg,webp

# Rate limits (per student) for AI features; login/sign-up limits are built in
RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=200
