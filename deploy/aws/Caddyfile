# Caddy gets and renews a free Let's Encrypt HTTPS certificate for {$DOMAIN} automatically.
{$DOMAIN} {
	encode zstd gzip

	# Backend API (Caddy replaces any client-sent X-Forwarded-For with the real client IP,
	# which the backend uses for rate limiting)
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}

	# Everything else: the Next.js website
	handle {
		reverse_proxy frontend:3000
	}
}
