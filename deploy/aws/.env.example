# Copy to deploy/aws/.env on the EC2 server (setup-ec2.sh does this and fills the first block).
# Never commit the real .env.

# ── Filled automatically by setup-ec2.sh ──
DOMAIN=1-2-3-4.sslip.io
FRONTEND_URL=https://1-2-3-4.sslip.io
CORS_ORIGINS=https://1-2-3-4.sslip.io
JWT_SECRET=generated-by-setup-script

# ── Fill these in yourself (same values as on Render) ──
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGODB_DB=smart_academic
AI_API_KEYS=

# ── Defaults (change only if needed) ──
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_CHAT_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-2
MAX_UPLOAD_MB=15
